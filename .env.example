# ---------- LOKAL (docker-compose) ----------
ENV=dev

DB_USER=marking_user
DB_PASSWORD=change_me_db_pass
DB_NAME=marking_db
DB_HOST=db
DB_PORT=5432

# ---------- RAILWAY ----------
# Railway'da DB_* o'rniga faqat DATABASE_URL kerak:
#   DATABASE_URL=${{ Postgres.DATABASE_URL }}
# Bu holda DB_* o'zgaruvchilari e'tiborga olinmaydi.
# DATABASE_URL=

# Celery uchun (hozircha ishlatilmayapti)
# REDIS_URL=redis://redis:6379/0

# ---------- MAJBURIY ----------
SECRET_KEY=CHANGE_ME_SUPER_SECRET
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASS
